{
  "name": "dsh-hippocampus",
  "version": "0.3.0-preview.5",
  "description": "DSH 记忆空间与海边小屋研发版：会话绑定、四层记忆、本地看板、AI 房间动作与持久存档",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./engine": "./lib/hippocampus.js",
    "./store": "./lib/store.js",
    "./locale/zh": "./locale/zh.json",
    "./locale/en": "./locale/en.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "tools",
    "tests",
    "examples",
    "docs",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "dashboard",
    "room"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "hippocampus",
    "agent",
    "long-term-memory"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "smoke": "node tests/smoke-host.mjs",
    "smoke:noprompt": "node tests/smoke-noprompt.mjs",
    "test:real": "node tests/real-host.mjs",
    "test:loader": "node tests/real-loader.mjs",
    "test:cordis": "node tests/real-cordis.mjs",
    "example": "node examples/embed.mjs",
    "migrate": "node tools/migrate.mjs",
    "check": "node tools/check-install.mjs",
    "check:plugin": "node tools/check-install.mjs --plugin-only",
    "release:check": "node tools/release-check.mjs",
    "pack": "node tools/pack.mjs",
    "cli": "node tools/hp.mjs",
    "doctor": "node tools/hp.mjs doctor",
    "dashboard": "node tools/dashboard.mjs --open",
    "dashboard:demo": "node tools/dashboard.mjs --demo --open",
    "preview:room": "node tools/preview-room.mjs --open",
    "test:room:host": "node tests/real-room.mjs",
    "dsh:install": "node tools/install.mjs",
    "dsh:uninstall": "node tools/install.mjs --uninstall"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wxy11117/DSH-Memory.git"
  },
  "homepage": "https://github.com/wxy11117/DSH-Memory#readme",
  "bugs": {
    "url": "https://github.com/wxy11117/DSH-Memory/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "meta": {
    "title": "海马体记忆",
    "description": "DSH 记忆空间与海边小屋研发版：会话绑定、四层记忆、本地看板、AI 房间动作与持久存档",
    "contributors": [
      "大肥鱼"
    ],
    "links": {
      "homepage": "https://github.com/wxy11117/DSH-Memory"
    }
  },
  "license": "MIT"
}
